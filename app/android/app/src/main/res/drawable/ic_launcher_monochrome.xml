<?xml version="1.0" encoding="utf-8"?>
<!--
    EyeSense monochrome layer for Android 13+ themed icons.

    Identical geometry to ic_launcher_foreground. The system ignores these
    colours and tints the layer from the user's wallpaper palette, so only the
    alpha channel carries meaning. Strokes are fine here: the platform
    rasterises the vector before extracting coverage.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FF000000"
        android:pathData="M43.8,53.88 m-5.46,0 a5.46,5.46 0 1,0 10.92,0 a5.46,5.46 0 1,0 -10.92,0" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="4.62"
        android:strokeLineCap="round"
        android:pathData="M50.71,44.36 A11.76,11.76 0 0 1 50.71,63.40" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="4.62"
        android:strokeLineCap="round"
        android:pathData="M54.66,38.93 A18.48,18.48 0 0 1 54.66,68.83" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="4.62"
        android:strokeLineCap="round"
        android:pathData="M58.61,33.49 A25.2,25.2 0 0 1 58.61,74.27" />
</vector>
